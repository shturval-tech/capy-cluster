{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "shturvalReleaseVersion": { "type": "string" },
    "kubeVersion": { "type": "string" },
    "platformUpgrade": { "type": "boolean" },
    "ingressControllerType": { "type": "string", "enum": ["nginx", "gateway"] },
    "secure": { "type": "boolean" },
    "licensetoken": { "type": "string" },
    "systemregistry": { "type": "string" },
    "nameOverride": { "type": "string" },
    "deletePersistentVolumes": { "type": "boolean" },
    "infrastructureProvider": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "string", "enum": ["auto", "true", "false"] }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabledservices": { "type": "array", "items": { "type": "string" } },
        "disablesservices": { "type": "array", "items": { "type": "string" } }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "strategy": { "type": "string", "enum": ["InPlace", "RollingUpdate"] }
      }
    },
    "vault": { "type": "object", "additionalProperties": true }
  }
}
